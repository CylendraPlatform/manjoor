# Create a NEW isolated Supabase project for MANJOOR. Never use Dukany credentials.
VITE_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_PROJECT_ANON_KEY
# Direct checkout stays off until legal review AND secure order handling exist.
VITE_ENABLE_PUBLIC_SALES=false
# Marketing site (no checkout). Keep false until you intend to preview or launch it.
VITE_ENABLE_PUBLIC_SITE=false
# Persist quote/wholesale inquiries. Keep false until the lead migration is applied
# on an isolated database and RLS/rate limits are tested.
VITE_ENABLE_LEAD_SUBMISSION=false
# Allow search engines. Keep false until launch gates in docs/phase-02/LAUNCH_READINESS.md pass.
VITE_ALLOW_INDEXING=false
