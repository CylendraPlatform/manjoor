# Create a NEW isolated Supabase project for MANJOOR. Never use Dukany credentials.
VITE_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_PROJECT_ANON_KEY
# Direct checkout stays off.
VITE_ENABLE_PUBLIC_SALES=false
# Public brochure and inquiry forms. Production uses the isolated MANJOOR project
# (see docs/launch/PRODUCTION_ENVIRONMENT.md). Do not point at Dukany.
VITE_ENABLE_PUBLIC_SITE=true
VITE_ENABLE_LEAD_SUBMISSION=true
# Keep false until docs/phase-03/SEO_AND_INDEXING_STATUS.md says indexing is approved.
VITE_ALLOW_INDEXING=false
# Temporary sales WhatsApp (international digits, no +). Easy to replace later.
VITE_BUSINESS_WHATSAPP=9647871857930
# Public origin for WhatsApp/Open Graph previews (absolute image URLs).
VITE_SITE_ORIGIN=https://manjoor.netlify.app
# Real workshop-product slides (photo/). Keep false until legal review of regulated goods.
VITE_ENABLE_WORKSHOP_PRODUCT_PROMO=false
